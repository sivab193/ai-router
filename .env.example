# Generate each secret independently. Never reuse or commit these values.
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
REDIS_PASSWORD=__REDIS_PASSWORD__
LITELLM_MASTER_KEY=__LITELLM_MASTER_KEY__
LITELLM_SALT_KEY=__LITELLM_SALT_KEY__
LITELLM_CONTROL_KEY=__LITELLM_CONTROL_KEY__
AI_ROUTER_ADMIN_TOKEN=__AI_ROUTER_ADMIN_TOKEN__

# Public address used in generated runner install commands.
AI_ROUTER_PUBLIC_URL=http://127.0.0.1:8088
AI_ROUTER_PUBLIC_HOST=ai.example.com
AI_ROUTER_ADMIN_HOST=admin.ai.example.com

# Pin after verifying the exact image in your environment.
LITELLM_IMAGE=ghcr.io/berriai/litellm:v1.101.3

# Model hub (Phase 6). All optional; the hub works without them.
# NAS path where model weights live (registry index only — no forced moves).
AI_ROUTER_NAS_PATH=
# OCI registry for KitOps/ModelKit artifacts, e.g. ghcr.io/your-org.
AI_ROUTER_OCI_REGISTRY=
# GCP project for one-click deploys. Auto-provision also needs the gcloud
# CLI where the control plane runs; leave 0 to provision by hand instead.
AI_ROUTER_GCP_PROJECT=
AI_ROUTER_GCP_ZONE=us-central1-a
AI_ROUTER_GCP_AUTO_PROVISION=0
AI_ROUTER_VLLM_IMAGE=vllm/vllm-openai:latest
