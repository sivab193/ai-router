:80 {
	encode zstd gzip
	request_body {
		max_size 32MB
	}
	header {
		-Server
		Content-Security-Policy "default-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; connect-src 'self'; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	@control path / /healthz /control/* /install/*
	handle @control {
		reverse_proxy control:8080
	}

	@inference path /v1/*
	handle @inference {
		reverse_proxy litellm:4000
	}

	handle {
		respond "not found" 404
	}
}
